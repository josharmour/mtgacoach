# Website development environment. Managed Coach clients do not use this file.
# Use development credentials for the features you are exercising locally.
# LITELLM_URL=
# LITELLM_MASTER_KEY=
# PATREON_CLIENT_ID=
# PATREON_CLIENT_SECRET=
# PATREON_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Admin dashboard password
ADMIN_PASSWORD=changeme

# Optional provider settings for the website service config.

# Azure OpenAI (typically cheapest for high volume)
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT is set in config.yaml

# Anthropic (Claude models)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=
