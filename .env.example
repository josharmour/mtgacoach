# Optional source-launcher settings
# Managed desktop users configure trial or subscriber access in Tools → Setup & Repair.
# The default coaching endpoint is https://api.mtgacoach.com/v1.
#
# Developers testing a different Coach-compatible gateway can explicitly set
# ARENAMCP_GATEWAY_URL in the process environment. Leave it unset for the
# normal public endpoint and keep any gateway_url setting empty.

# Launcher maintenance
# Automatically trim Player.log before launch when MTGA is not already running.
ARENAMCP_TRIM_PLAYER_LOG=1
# Trim when Player.log exceeds this size in MB.
ARENAMCP_PLAYER_LOG_MAX_MB=64
# Keep the newest tail of Player.log at this size in MB.
ARENAMCP_PLAYER_LOG_KEEP_MB=8
